		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Currículo e portfólio profissional de Clarissa Morita. Desenvolvimento de sistemas, web e mobile."
		/>
		<title>{pt.pageTitle}</title>
