			</section>

			<section class="grid">
				{pt.highlights.map((item, i) => (
					<article class="card">
						<h3 data-i18n={`highlights.${i}.title`}>{item.title}</h3>
						<p data-i18n={`highlights.${i}.description`}>{item.description}</p>
					</article>
				))}
			</section>

			<section class="panel">
				<h2 data-i18n="projectsTitle">{pt.projectsTitle}</h2>
				<div class="project-grid">
					{pt.projects.map((project, i) => (
						<article class="project-card">
							<h3 data-i18n={`projects.${i}.name`}>{project.name}</h3>
							<p data-i18n={`projects.${i}.description`}>{project.description}</p>
							<a href={projectUrls[i]} target="_blank" rel="noreferrer" data-i18n="repoLink">{pt.repoLink}</a>
						</article>
					))}
				</div>
			</section>

			<section class="panel roadmap">
				<h2 data-i18n="stepsTitle">{pt.stepsTitle}</h2>
				<ol>
					{pt.steps.map((step, i) => <li data-i18n={`steps.${i}`}>{step}</li>)}
				</ol>
			</section>
		</main>

		<script type="application/json" id="i18n-data" set:html={JSON.stringify(translations)}></script>
		<script is:inline>
			(function () {
				var data = JSON.parse(document.getElementById("i18n-data").textContent);

				function setLang(lang) {
					if (!data[lang]) lang = "pt";
					var dict = data[lang];
					document.querySelectorAll("[data-i18n]").forEach(function (el) {
						var text = dict[el.getAttribute("data-i18n")];
						if (text !== undefined) el.textContent = text;
					});
					document.querySelectorAll("[data-i18n-alt]").forEach(function (el) {
						var text = dict[el.getAttribute("data-i18n-alt")];
						if (text !== undefined) el.setAttribute("alt", text);
					});
					document.documentElement.lang = lang === "en" ? "en" : "pt-BR";
					document.title = dict.pageTitle;
					document.querySelectorAll("[data-set-lang]").forEach(function (btn) {
						btn.setAttribute("aria-pressed", String(btn.getAttribute("data-set-lang") === lang));
					});
					try { localStorage.setItem("lang", lang); } catch (e) {}
				}

				// Prioridade: ?lang=en no link > escolha salva > português
				var fromUrl = new URLSearchParams(location.search).get("lang");
				var saved = null;
				try { saved = localStorage.getItem("lang"); } catch (e) {}
				setLang(fromUrl || saved || "pt");

				document.querySelectorAll("[data-set-lang]").forEach(function (btn) {
					btn.addEventListener("click", function () {
						setLang(btn.getAttribute("data-set-lang"));
					});
				});
			})();
		</script>
	</body>
</html>

<style>
	@import url("https://fonts.googleapis.com/css2?family=Syne:wght@500;700;800&family=IBM+Plex+Sans:wght@400;500;600&display=swap");

	:root {
		--bg: #0d121e;
		--bg-soft: #111a2b;
		--panel: rgba(14, 24, 42, 0.82);
		--line: rgba(146, 175, 222, 0.25);
		--text: #ebf1ff;
		--muted: #b7c6e6;
		--accent: #00d4b3;
		--accent-2: #ffc857;
		--shadow: 0 24px 70px rgba(5, 10, 19, 0.45);
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		font-family: "IBM Plex Sans", sans-serif;
		background:
			radial-gradient(circle at 15% 12%, rgba(0, 212, 179, 0.2), transparent 42%),
			radial-gradient(circle at 88% 15%, rgba(255, 200, 87, 0.26), transparent 35%),
			linear-gradient(140deg, var(--bg), #111d34 45%, #101623 100%);
		color: var(--text);
		min-height: 100vh;
	}

	.background-glow {
		position: fixed;
		inset: 0;
		pointer-events: none;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
		background-size: 48px 48px;
		opacity: 0.14;
		mask-image: radial-gradient(circle at center, black 38%, transparent 90%);
	}

	.page {
		max-width: 1060px;
		margin: 0 auto;
		padding: 4.4rem 1.25rem 4rem;
		display: grid;
		gap: 1.1rem;
	}

	.hero,
	.panel,
	.card {
		border: 1px solid var(--line);
		background: var(--panel);
		backdrop-filter: blur(10px);
		border-radius: 1.25rem;
		box-shadow: var(--shadow);
		animation: rise 0.78s ease both;
	}

	.hero {
		padding: 2rem;
	}

	.hero-grid {
		display: flex;
		align-items: flex-start; /* avatar alinhado ao topo */
		gap: 1.1rem;
	}

	.hero-photo img {
		width: 124px;
		height: 124px;
		object-fit: cover;
		border-radius: 50%;
		border: 3px solid rgba(255,255,255,0.12);
		box-shadow: 0 12px 34px rgba(2,8,20,0.6);
	}

	.hero-photo {
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.tag {
		display: inline-flex;
		padding: 0.35rem 0.8rem;
		border-radius: 999px;
		font-weight: 600;
		font-size: 0.8rem;
		letter-spacing: 0.04em;
		color: #082b26;
		background: linear-gradient(90deg, var(--accent), #72f0d8);
		margin: 0 0 1rem;
	}

	h1,
	h2,
	h3 {
		font-family: "Syne", sans-serif;
		margin: 0;
	}

	h1 {
		font-size: clamp(2rem, 4.5vw, 3.4rem);
		line-height: 1.03;
		display: grid;
		gap: 0.3rem;
	}

	h1 span {
		color: var(--accent-2);
		font-size: clamp(1rem, 2vw, 1.35rem);
		letter-spacing: 0.03em;
	}

	.summary {
		margin: 0.5rem 0 0;
		max-width: 70ch;
		font-size: 1.02rem;
		color: var(--muted);
		line-height: 1.72;
	}

	.cta-group {
		display: flex;
		gap: 0.7rem;
		margin-top: 1.5rem;
		flex-wrap: wrap;
	}

	.btn {
		text-decoration: none;
		font-weight: 700;
		padding: 0.7rem 1rem;
		border-radius: 0.8rem;
		transition: transform 200ms ease, background-color 200ms ease;
	}

	.btn:hover {
		transform: translateY(-2px);
	}

	.btn.primary {
		background: linear-gradient(90deg, var(--accent), #4fe6ca);
		color: #06231f;
	}

	.btn.ghost {
		border: 1px solid rgba(255, 255, 255, 0.35);
		color: var(--text);
	}

	.panel {
		padding: 1.5rem;
	}

	.panel h2 {
		font-size: clamp(1.35rem, 2vw, 1.7rem);
		margin-bottom: 0.8rem;
	}

	.panel p {
		color: var(--muted);
		line-height: 1.68;
		margin: 0;
	}

	.about h3 {
		margin-top: 2rem;
		margin-bottom: 0.6rem;
	}

	.about {
		display: grid;
		grid-template-columns: 3fr 2fr;
		column-gap: 3rem;
		row-gap: 1.5rem;
		align-items: start;
	}

	.about ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
		padding-left: 3rem;
		border-left: 1px solid rgba(255, 255, 255, 0.08);
	}

	.about li {
		display: grid;
		gap: 0.4rem;
		padding: 1rem 1.15rem;
		line-height: 1.6;
		border-radius: 0.8rem;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	.about strong {
		font-size: 0.88rem;
		color: #d2def8;
	}

	.about span {
		font-size: 0.98rem;
		color: #f3f7ff;
	}

	.skills {
		display: flex;
		gap: 0.65rem;
		flex-wrap: wrap;
	}

	.chip {
		padding: 0.48rem 0.75rem;
		border-radius: 999px;
		font-size: 0.84rem;
		font-weight: 700;
		background: linear-gradient(90deg, rgba(0, 212, 179, 0.19), rgba(255, 200, 87, 0.18));
		border: 1px solid rgba(255, 255, 255, 0.12);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.card {
		padding: 1.2rem;
	}

	.card h3 {
		font-size: 1.15rem;
		margin-bottom: 0.45rem;
	}

	.card p {
		margin: 0;
		line-height: 1.62;
		color: var(--muted);
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.85rem;
	}

	.project-card {
		padding: 1rem;
		border-radius: 0.9rem;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.1);
		display: grid;
		gap: 0.5rem;
	}

	.project-card h3 {
		font-size: 1.08rem;
	}

	.project-card p {
		margin: 0;
		color: var(--muted);
		line-height: 1.55;
	}

	.project-card a {
		text-decoration: none;
		color: #97ffe9;
		font-weight: 700;
		font-size: 0.92rem;
		width: fit-content;
	}

	.project-card a:hover {
		text-decoration: underline;
	}

	.roadmap ol {
		margin: 0;
		padding-left: 1.1rem;
