						</div>
					</div>
				</div>
			</header>

			<section class="panel about">
				<div>
					<h2 data-i18n="aboutTitle">{pt.aboutTitle}</h2>
					<p data-i18n="aboutText">{pt.aboutText}</p>
					<h3 data-i18n="educationTitle">{pt.educationTitle}</h3>
					<p class="education">
						<strong data-i18n="degree">{pt.degree}</strong><br />
						<span data-i18n="school">{pt.school}</span>
					</p>
				</div>
				<ul>
					<li>
						<strong data-i18n="locationLabel">{pt.locationLabel}</strong>
						<span data-i18n="location">{pt.location}</span>
					</li>
					<li>
						<strong data-i18n="techLabel">{pt.techLabel}</strong>
						<span data-i18n="tech">{pt.tech}</span>
					</li>
					<li>
						<strong data-i18n="currentLabel">{pt.currentLabel}</strong>
						<span data-i18n="current">{pt.current}</span>
					</li>
				</ul>
			</section>

			<section class="panel">
				<h2 data-i18n="experienceTitle">{pt.experienceTitle}</h2>
				<div class="project-grid">
					{pt.experience.map((job, i) => (
						<article class="project-card">
							<h3 data-i18n={`experience.${i}.role`}>{job.role}</h3>
							<p><strong>{company}</strong> · <span data-i18n={`experience.${i}.period`}>{job.period}</span></p>
							<p data-i18n={`experience.${i}.description`}>{job.description}</p>
						</article>
					))}
				</div>
			</section>

			<section class="panel">
